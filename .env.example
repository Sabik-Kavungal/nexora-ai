# Nexora — AI Knowledge & RAG Platform Environment Configuration
PORT=3000
NODE_ENV=production
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/nexora"
JWT_SECRET="supersecret-jwt-key-production-nexora-2026-secure"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"

# Hugging Face Provider
AI_PROVIDER="huggingface"
HF_TOKEN=""
HF_GENERATION_MODEL="meta-llama/Llama-3.1-8B-Instruct"
HF_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# RAG & Chunking Parameters
RAG_TOP_K="4"
RAG_SIMILARITY_THRESHOLD="0.35"
CHUNK_SIZE="800"
CHUNK_OVERLAP="150"
MAX_INPUT_TOKENS="2048"
MAX_OUTPUT_TOKENS="1024"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
